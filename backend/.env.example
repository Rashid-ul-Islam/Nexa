# Server Configuration
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database (MongoDB Atlas)
# The database name MUST be the last path segment before '?' and must end in _dev, _e2e, or _prod
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/opportunity_finder_dev?retryWrites=true&w=majority

# Authentication & Session
JWT_SECRET=replace_with_at_least_32_characters_random_secret_string
JWT_EXPIRES_IN_DAYS=7
COOKIE_NAME=of_session

# Client & Network
# Comma-separated list of allowed origins
FRONTEND_URL=http://localhost:5173
TRUST_PROXY_HOPS=0

# Email & Notifications (Resend)
RESEND_API_KEY=
EMAIL_FROM=Opportunity Finder <reminders@example.com>
EMAIL_TOKEN_SECRET=replace_with_at_least_32_characters_random_token_secret

# Background Jobs & Scheduler
ENABLE_IN_PROCESS_JOBS=true
CRON_SECRET=replace_with_secret_for_internal_job_trigger

# Seeding Credentials (development only)
SEED_ADMIN_EMAIL=admin@opportunityfinder.local
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_DEMO_PASSWORD=StudentPass123!
